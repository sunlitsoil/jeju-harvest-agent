# 모두 선택 사항이다. 비워 두면 규칙 계획기로만 동작한다(인터넷만 필요).
# OpenAI 호환 모델 서버(예: 센터 PC의 Ollama, llama.cpp server, 또는 클라우드)를 쓸 때만 채운다.
# 예) Ollama: LLM_BASE_URL=http://127.0.0.1:11434/v1  LLM_MODEL=qwen3.5:4b
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT=60
# 계획기: auto(기본, 규칙이 작물을 못 찾을 때만 LLM) | llm(LLM이 먼저 도구를 고름, 큰 모델 권장) | rule(LLM 안 씀)
AGENT_PLANNER=auto
# 캐시 유지 시간(초), 기본 6시간
JEJU_AGENT_CACHE_TTL=21600
# 1이면 인터넷 없이 캐시만 사용
JEJU_AGENT_OFFLINE=0
PORT=8765
